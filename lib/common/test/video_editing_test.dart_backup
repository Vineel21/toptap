import 'dart:convert';
import 'dart:io';
import 'package:flutter/material.dart';
import 'package:shortzz/common/service/ffmpeg_video_service.dart';
import 'package:shortzz/common/controller/text_element.dart';

/// Test class to validate video editing text burning functionality
class VideoEditingTest {
  /// Test the enhanced text burning functionality
  static Future<Map<String, dynamic>> testTextBurning({
    required String testVideoPath,
    required String testText,
  }) async {
    try {
      print('🧪 TESTING ENHANCED VIDEO TEXT BURNING');
      print('   - Test video: $testVideoPath');
      print('   - Test text: "$testText"');

      // Create test text element
      final textElement = TextElement(
        text: testText,
        position:
            const Offset(100, 100), // Center-ish position
        color: Colors.white,
        fontSize: 24,
        scale: 1.0,
        rotation: 0,
        fontFamily: 'Roboto',
      );

      final testElements = [textElement];
      final videoSize =
          const Size(720, 1280); // Standard video size

      print('📝 Created test text element:');
      print('   - Text: "${textElement.text}"');
      print(
          '   - Position: (${textElement.position.dx}, ${textElement.position.dy})');
      print('   - Color: ${textElement.color}');
      print('   - Font size: ${textElement.fontSize}');

      // Test the enhanced FFmpeg service
      final startTime = DateTime.now();

      final processedVideoPath =
          await FFmpegVideoService.processVideoWithOverlays(
        inputVideoPath: testVideoPath,
        textElements: testElements,
        stickerElements: [],
        drawingPaths: [],
        videoSize: videoSize,
      );

      final endTime = DateTime.now();
      final processingTime = endTime.difference(startTime);

      print(
          '⏱️ Processing completed in: ${processingTime.inMilliseconds}ms');

      // Validate results
      final testResults = await _validateProcessingResults(
        originalPath: testVideoPath,
        processedPath: processedVideoPath,
        expectedText: testText,
      );

      return {
        'success': testResults['success'],
        'originalPath': testVideoPath,
        'processedPath': processedVideoPath,
        'processingTimeMs': processingTime.inMilliseconds,
        'validation': testResults,
        'timestamp': DateTime.now().toIso8601String(),
      };
    } catch (e) {
      print('❌ Video editing test failed: $e');
      return {
        'success': false,
        'error': e.toString(),
        'timestamp': DateTime.now().toIso8601String(),
      };
    }
  }

  /// Validate the processing results
  static Future<Map<String, dynamic>>
      _validateProcessingResults({
    required String originalPath,
    required String processedPath,
    required String expectedText,
  }) async {
    try {
      print('🔍 VALIDATING PROCESSING RESULTS');

      final validation = <String, dynamic>{
        'success': false,
        'checks': <String, dynamic>{},
      };

      // Check 1: Different paths (processing occurred)
      final pathsAreDifferent =
          originalPath != processedPath;
      validation['checks']['paths_different'] =
          pathsAreDifferent;
      print('   ✓ Paths different: $pathsAreDifferent');

      // Check 2: Processed file exists
      final processedFile = File(processedPath);
      final processedExists = await processedFile.exists();
      validation['checks']['processed_file_exists'] =
          processedExists;
      print('   ✓ Processed file exists: $processedExists');

      if (processedExists) {
        // Check 3: File size comparison
        final originalFile = File(originalPath);
        final originalSize = await originalFile.length();
        final processedSize = await processedFile.length();

        validation['checks']['original_size'] =
            originalSize;
        validation['checks']['processed_size'] =
            processedSize;
        validation['checks']['size_changed'] =
            processedSize != originalSize;

        print('   ✓ Original size: $originalSize bytes');
        print('   ✓ Processed size: $processedSize bytes');
        print(
            '   ✓ Size changed: ${processedSize != originalSize}');

        // Check 4: File is valid MP4
        try {
          final header =
              await processedFile.openRead(0, 20).first;
          final isValidMp4 = header.length >= 4;
          validation['checks']['valid_mp4_header'] =
              isValidMp4;
          print('   ✓ Valid MP4 header: $isValidMp4');
        } catch (e) {
          validation['checks']['valid_mp4_header'] = false;
          print('   ✗ MP4 header check failed: $e');
        }

        // Check 5: Metadata file exists (if created)
        final metadataPath = processedPath.replaceAll(
            '.mp4', '_overlay_metadata.json');
        final metadataFile = File(metadataPath);
        final hasMetadata = await metadataFile.exists();
        validation['checks']['has_metadata'] = hasMetadata;
        print('   ✓ Has metadata file: $hasMetadata');

        if (hasMetadata) {
          try {
            final metadataContent =
                await metadataFile.readAsString();
            final metadata = jsonDecode(metadataContent);
            validation['checks']['metadata'] = metadata;
            print('   ✓ Metadata loaded successfully');
            print(
                '   ✓ Processing method: ${metadata['processingMethod']}');
          } catch (e) {
            print('   ⚠️ Could not read metadata: $e');
          }
        }
      }

      // Overall success determination
      validation['success'] = pathsAreDifferent &&
          processedExists &&
          (validation['checks']['size_changed'] == true ||
              validation['checks']['has_metadata'] == true);

      print(
          '🎯 VALIDATION RESULT: ${validation['success'] ? 'SUCCESS' : 'NEEDS_IMPROVEMENT'}');

      return validation;
    } catch (e) {
      print('❌ Validation failed: $e');
      return {
        'success': false,
        'error': e.toString(),
      };
    }
  }

  /// Create a simple test video for testing (if needed)
  static Future<String> createTestVideo() async {
    // This would create a simple test video file
    // For now, we'll assume a test video exists
    // In real implementation, you could use ffmpeg to create a simple test video
